# Huddle reads these values from .env when you run npm run food:server.
FOOD_PORT=8788
FOOD_HOST=127.0.0.1
FOOD_PUBLIC_ORIGIN=http://localhost:8788
FOOD_DATA_FILE=.data/food.json
# Your phone requires a reachable origin, such as http://192.168.1.20:8788.
# Your server requires FOOD_HOST=0.0.0.0 for a local network demo.
# Your public deployment requires an HTTPS reverse proxy and a persistent data directory.
