{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "moduleSuffixes": [
      ".web",
      ""
    ]
  },
  "include": [
    "App.tsx",
    "src",
    "index.web.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "src/platform/tv.tsx",
    "src/platform/learningStorage.ts"
  ]
}
