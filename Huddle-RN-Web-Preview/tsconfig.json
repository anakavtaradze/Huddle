{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "noEmit": true, "baseUrl": ".", "paths": {"react-native": ["./node_modules/react-native-web"]}
  },
  "include": ["App.tsx", "src", "index.web.tsx", "vite.config.ts"]
}
