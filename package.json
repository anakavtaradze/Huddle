{
  "name": "huddle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix Huddle-RN-Web-Preview run dev",
    "check:web": "npm --prefix Huddle-RN-Web-Preview run build",
    "test": "node --test tests/*.test.mjs",
    "ai:server": "node server/ai-server.mjs",
    "vega:setup": "node scripts/vega.mjs setup",
    "vega:sync": "node scripts/vega.mjs sync",
    "vega:build": "node scripts/vega.mjs build",
    "vega:run": "node scripts/vega.mjs run",
    "ai:vega": "vega exec vda reverse tcp:8787 tcp:8787",
    "ai:check": "node --env-file-if-exists=.env server/check-ai.mjs",
    "food:server": "node --env-file-if-exists=.env server/food-server.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
